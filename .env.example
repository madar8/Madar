# Server reads environment variables from the operating system; this file is documentation only.
MADAR_DATA_DIR=/absolute/path/to/madar-data
# Set to 1 behind HTTPS. Keep 0 only on local HTTP.
MADAR_SECURE_COOKIE=1

# Optional one-time browser setup. Generate a random token of at least 32 characters.
# Never commit a real token. Render generates this automatically.
# MADAR_SETUP_TOKEN=
